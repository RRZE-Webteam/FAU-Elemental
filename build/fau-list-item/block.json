{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fau-elemental/fau-list-item",
  "version": "0.1.0",
  "title": "FAU Teaser Grid",
  "category": "fau-elemental/FAU",
  "icon": "grid-view",
  "description": "Display posts or pages in a grid layout with FAU styling",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "fau-elemental",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "viewScript": "file:./view.js",
  "attributes": {
    "variant": {
      "type": "string",
      "default": "post"
    },
    "postsPerPage": {
      "type": "number",
      "default": 15
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "showFilters": {
      "type": "boolean",
      "default": false
    },
    "selectedCategory": {
      "type": "number",
      "default": 0
    },
    "currentPage": {
      "type": "number",
      "default": 1
    }
  }
}