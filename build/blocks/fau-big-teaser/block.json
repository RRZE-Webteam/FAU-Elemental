{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fau-elemental/fau-big-teaser",
  "version": "0.1.0",
  "title": "FAU Big Teaser",
  "category": "fau-elemental/FAU",
  "icon": "megaphone",
  "description": "A feature teaser component with roof line, headline, teaser text, link and image",
  "supports": {
    "html": false,
    "className": true
  },
  "textdomain": "fau-elemental",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "roofLine": {
      "type": "string",
      "default": ""
    },
    "headline": {
      "type": "string",
      "default": ""
    },
    "teaserText": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "linkTarget": {
      "type": "string",
      "default": "_self"
    },
    "image": {
      "type": "object",
      "default": null
    },
    "showRoofLine": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "roofLine": "Featured",
      "headline": "Sample Headline",
      "teaserText": "This is a sample teaser text that demonstrates the component.",
      "linkText": "Learn More",
      "linkUrl": "#",
      "showRoofLine": true
    }
  }
}