{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fau-elemental/fau-info-box",
  "version": "0.1.0",
  "title": "FAU Info Box",
  "category": "fau-elemental/FAU",
  "icon": "info-outline",
  "description": "Editorial component for highlighting and emphasizing information",
  "supports": {
    "html": false,
    "className": true
  },
  "textdomain": "fau-elemental",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "attributes": {
    "headline": {
      "type": "string",
      "default": "",
      "source": "text",
      "selector": "h3.fau-info-box-headline"
    },
    "content": {
      "type": "string",
      "default": "",
      "source": "html",
      "selector": "p.fau-info-box-content"
    },
    "image": {
      "type": "object",
      "default": null
    },
    "ctaButton": {
      "type": "object",
      "default": null
    }
  }
}