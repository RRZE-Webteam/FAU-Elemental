{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "fau-elemental/fau-teaser-grid",
    "version": "0.1.0",
    "title": "FAU Teaser Grid",
    "category": "fau-elemental/FAU",
    "icon": "grid-view",
    "description": "Display posts or pages in a grid layout with FAU styling",
    "supports": {
        "html": false,
        "className": true
    },
	"textdomain": "fau-elemental",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",

    "attributes": {
        "variant": {
            "type": "string",
            "default": "post"
        },
        "postsPerPage": {
            "type": "number",
            "default": 3
        },
        "showFilters": {
            "type": "boolean",
            "default": false
        },
        "selectedCategory": {
            "type": "number",
            "default": 0
        },
        "selectedTaxonomy": {
            "type": "string",
            "default": ""
        },
        "currentPage": {
            "type": "number",
            "default": 1
        },
        "displayStyle": {
            "type": "string",
            "default": "teaser-grid"
        },
        "showPagination": {
            "type": "boolean",
            "default": true
        },
        "totalPosts": {
            "type": "number",
            "default": 3
        },
        "orderBy": {
            "type": "string",
            "default": "date"
        },
        "order": {
            "type": "string",
            "default": "DESC"
        },
        "teaserLayout": {
            "type": "string",
            "default": "3m"
        },
        "teaserSizes": {
            "type": "array",
            "default": []
        },
        "selectedPosts": {
            "type": "array",
            "default": []
        },
        "selectionMode": {
            "type": "string",
            "default": "auto"
        }
    }
    
}
