{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fau-elemental/fau-big-button-teaser-group",
  "version": "0.1.0",
  "title": "FAU Big Button Teaser Group",
  "category": "fau-elemental/FAU",
  "icon": "button",
  "description": "Display a group of big button teasers for linking to other pages",
  "supports": {
    "html": false,
    "className": true
  },
  "textdomain": "fau-elemental",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "roofLine": {
      "type": "string",
      "default": ""
    },
    "showRoofLine": {
      "type": "boolean",
      "default": false
    },
    "headline": {
      "type": "string",
      "default": ""
    },
    "showHeadline": {
      "type": "boolean",
      "default": false
    },
    "teaserText": {
      "type": "string",
      "default": ""
    },
    "showTeaserText": {
      "type": "boolean",
      "default": false
    },
    "facultyColor": {
      "type": "string",
      "enum": [
        "default",
        "fau",
        "phil",
        "rw",
        "med",
        "nat",
        "tf"
      ],
      "default": "default"
    },
    "teaserSize": {
      "type": "string",
      "enum": [
        "small",
        "large"
      ],
      "default": "small"
    },
    "variant": {
      "type": "string",
      "enum": [
        "filled",
        "outline"
      ],
      "default": "filled"
    },
    "numberOfButtons": {
      "type": "number",
      "minimum": 1,
      "default": 3
    },
    "selectedPages": {
      "type": "array",
      "default": []
    },
    "showAllPages": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "roofLine": "Featured Services",
      "showRoofLine": true,
      "headline": "Discover Our Services",
      "showHeadline": true,
      "teaserText": "Explore the various services and resources available to you.",
      "showTeaserText": true,
      "facultyColor": "fau",
      "teaserSize": "small",
      "variant": "filled",
      "numberOfButtons": 3,
      "selectedPages": [],
      "showAllPages": false
    }
  }
} 