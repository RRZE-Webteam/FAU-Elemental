{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Fau Elemental",
	"slug": "fau-elemental",
	"description": "Fau Elemental",
	"settings": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				},
				"color": {
					"custom": false,
					"customGradient": false,
					"defaultGradients": false,
					"defaultPalette": false
				},
				"shadow": {}
			},
			"core/group": {
				"color": {
					"text": false,
					"button": false,
					"heading": false
				}
			}
		},
		"color": {
			"background": false,
			"text": false
		},
		"spacing": {
			"blockGap": false,
			"margin": false,
			"padding": false
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"textDecoration": false,
			"textTransform": false
		},
		"layout": {
			"contentSize": "1320px"
		}
	},
	"customTemplates": [
		{
			"name": "just-content",
			"title": "Just Content",
			"postTypes": [ "page", "post" ]
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"patterns": [],
	"blockTypes": []
}
