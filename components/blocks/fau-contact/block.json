{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fau-elemental/fau-contact",
	"version": "0.1.0",
	"title": "FAU Contact",
	"category": "fau-elemental/FAU",
	"icon": "businessperson",
	"description": "Display contact information with professional layout matching FAU design",
	"supports": {
		"html": false,
		"multiple": true
	},
	"attributes": {
		"showTopLine": {
			"type": "boolean",
			"default": false
		},
		"topLine": {
			"type": "string",
			"default": ""
		},
		"headline": {
			"type": "string",
			"default": ""
		},
		"showAddress": {
			"type": "boolean",
			"default": false
		},
		"address": {
			"type": "string",
			"default": ""
		},
		"showOpeningHours": {
			"type": "boolean",
			"default": false
		},
		"openingHours": {
			"type": "string",
			"default": ""
		},
		"contactLinks": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": ["phone", "email", "messenger", "website", "matrix"]
					},
					"label": {
						"type": "string"
					},
					"value": {
						"type": "string"
					}
				}
			}
		},
		"socialMedia": {
			"type": "object",
			"default": {},
			"properties": {
				"instagram": { "type": "string" },
				"facebook": { "type": "string" },
				"xing": { "type": "string" },
				"linkedin": { "type": "string" },
				"twitter": { "type": "string" },
				"mastodon": { "type": "string" },
				"bluesky": { "type": "string" },
				"youtube": { "type": "string" },
				"tiktok": { "type": "string" }
			}
		}
	},
	"example": {
		"attributes": {
			"showTopLine": true,
			"topLine": "Forschung an der FAU",
			"headline": "Prof. Dr. Max Mustermann",
			"showAddress": true,
			"address": "Schlossplatz 4\n91054 Erlangen",
			"showOpeningHours": true,
			"openingHours": "Mo., Di. und Do.\n10:00-16:00 Uhr",
			"contactLinks": [
				{
					"type": "phone",
					"label": "Telefon",
					"value": "+49 9131 85-12345"
				},
				{
					"type": "email",
					"label": "E-Mail",
					"value": "max.mustermann@fau.de"
				}
			],
			"socialMedia": {
				"twitter": "https://twitter.com/unifau",
				"linkedin": "https://linkedin.com/company/fau"
			}
		}
	},
	"textdomain": "fau-elemental",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
} 