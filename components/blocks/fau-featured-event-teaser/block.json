{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fau-elemental/featured-event-teaser",
	"version": "1.0.0",
	"title": "Featured Event Teaser",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "A block to display a featured event with details.",
	"attributes": {
		"eventTitle": {
			"type": "string"
		},
		"eventDescription": {
			"type": "string"
		},
		"eventDate": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": "Mehr erfahren"
		},
		"buttonUrl": {
			"type": "string",
			"default": "#"
		},
		"showImage": {
			"type": "boolean",
			"default": false
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"textdomain": "fau-elemental",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style-theme.css"
}
