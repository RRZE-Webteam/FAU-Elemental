{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fau-elemental/fau-facts-grid",
	"version": "0.1.0",
	"title": "FAU Facts Grid",
	"category": "fau-elemental/FAU",
	"icon": "grid-view",
	"description": "Display key facts and figures with optional roof line, custom icons, and links",
	"supports": {
		"html": false,
		"className": true
	},
	"textdomain": "fau-elemental",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style-theme.css",

	"attributes": {
		"facts": {
			"type": "array",
			"default": [
				{
					"text": "",
					"iconUrl": "",
					"iconId": null,
					"link": "",
					"showLink": false
				}
			]
		}
	}
}
